B,> .FIGURA #AG <'MOLDE T(TIL #AG,>3
     RET*NGULO'
C,> .FIGURA #AH <'MOLDE T(TIL #AH,>3
     TRAP=ZIO'
D,> .FIGURA #AI <'MOLDE T(TIL #AI,>3
     PARALELOGRAMO'
   .TODAS T<M QUANTOS LADOS5 <' ,>
   .QUAIS T<M OS #D LADOS DO MESMO
   TAMANHO5 <' ,>
   .QUAIS T<M DOIS PARES DE LADOS
