                                      #B
    .POL/GONOS E FIGURAS CONGRUENTES

.VERS>O .A1 MAIS APOIO' TERCEIRO ANO'
.HABILIDADE ..EF#JC..MA#AE1
..EF#JC..MA#AF'
.NOME3 <' ,> .DATA3 <' ,>

#A' .CONTE OS LADOS' .CIRCULE O N)MERO'
   .DICA3 .PASSE O DEDO EM CADA LADO E
   FA&A UM RISQUINHO'
A,> .EXEMPLO' .FIGURA #A <'MOLDE T(TIL
     #A,>3 POL/GONO REGULAR DE #C LADOS'
   .OP&[ES3 #C2 #D' .RESPOSTA3 #C'
B,> .FIGURA #B <'MOLDE T(TIL #B,>3
     POL/GONO REGULAR DE #D LADOS'
   .OP&[ES3 #D2 #E'
C,> .FIGURA #C <'MOLDE T(TIL #C,>3
     TRAP=ZIO'
   .OP&[ES3 #C2 #D'
D,> .FIGURA #D <'MOLDE T(TIL #D,>3
     POL/GONO REGULAR DE #F LADOS'
   .OP&[ES3 #E2 #F'

#B' .QUAL = IGUAL AO MODELO5 .CIRCULE'
                                      #C
   .DICA3 .RECORTE O MODELO E COLOQUE
   POR CIMA PARA CONFERIR'
   .FIGURA #E <'MOLDE T(TIL #E,>3
   MODELO3 TRI*NGULO'
   .OP&[ES3 .FIGURA #F <'MOLDE T(TIL
   #F,>3 POL/GONO REGULAR DE #C LADOS2
   .FIGURA #G <'MOLDE T(TIL #G,>3
   POL/GONO REGULAR DE #C LADOS2 .FIGURA
   #H <'MOLDE T(TIL #H,>3 POL/GONO
   REGULAR DE #D LADOS'
                                      #D
    .POL/GONOS E FIGURAS CONGRUENTES

.VERS>O .B1 APOIO MODERADO' TERCEIRO
ANO' .HABILIDADE ..EF#JC..MA#AE1
..EF#JC..MA#AF'
.NOME3 <' ,> .DATA3 <' ,>

#A' .COMPLETE O QUADRO'
   .DICA3 .NOMES3 QUADRADO1 RET*NGULO1
   TRAP=ZIO1 PARALELOGRAMO'
   .TABELA COM #E LINHAS3 COLUNAS
   .FIGURA2 .NOME2 .LADOS2 .V=RTICES'
.LINHA #A' .FIGURA3 .FIGURA #I <'MOLDE
     T(TIL #I,>3 POL/GONO REGULAR DE #C
     LADOS'2 .NOME3 TRI*NGULO2 .LADOS3
     #C2 .V=RTICES3 #C'
.LINHA #B' .FIGURA3 .FIGURA #AJ <'MOLDE
     T(TIL #AJ,>3 POL/GONO REGULAR DE #D
     LADOS'2 .NOME3 <' ,>2 .LADOS3 <'
     ,>2 .V=RTICES3 <' ,>'
.LINHA #C' .FIGURA3 .FIGURA #AA <'MOLDE
     T(TIL #AA,>3 RET*NGULO'2 .NOME3 <'
     ,>2 .LADOS3 <' ,>2 .V=RTICES3 <'
     ,>'
                                      #E
.LINHA #D' .FIGURA3 .FIGURA #AB <'MOLDE
     T(TIL #AB,>3 TRAP=ZIO'2 .NOME3 <'
     ,>2 .LADOS3 <' ,>2 .V=RTICES3 <'
     ,>'
.LINHA #E' .FIGURA3 .FIGURA #AC <'MOLDE
     T(TIL #AC,>3 PARALELOGRAMO'2 .NOME3
     <' ,>2 .LADOS3 <' ,>2 .V=RTICES3 <'
     ,>'

#B' .COPIE A FIGURA NA MALHA AO LADO'
   .FIGURA #AD <'MOLDE T(TIL #AD,>3
   FIGURA PINTADA NA MALHA'
   .FIGURA #AE <'MOLDE T(TIL #AE,>3
   MALHA VAZIA'
                                      #F
    .POL/GONOS E FIGURAS CONGRUENTES

.VERS>O .C1 APOIO LEVE' TERCEIRO ANO'
.HABILIDADE ..EF#JC..MA#AE1
..EF#JC..MA#AF'
.NOME3 <' ,> .DATA3 <' ,>

#A' .RESPONDA OLHANDO AS FIGURAS'
A,> .FIGURA #AF <'MOLDE T(TIL #AF,>3
